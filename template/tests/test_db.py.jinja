"""Tests of the database layer: names, migrations, the tables' declared rules and views, on SQLite."""

from __future__ import annotations

import json
import os
from datetime import datetime
from pathlib import Path

import pytest
import sqlalchemy as sa
from alembic.autogenerate import compare_metadata
from alembic.runtime.migration import MigrationContext
from typer.testing import CliRunner

from {{ package_name }}.cli import app
from {{ package_name }}.core import db, tables
from {{ package_name }}.core.errors import DatabaseNotMigrated, DatabaseTooNew, DatabaseUnavailable, InvalidArguments

runner = CliRunner()

# The real PostgreSQL contract (advisory lock, sequences, psycopg) runs only against
# the throwaway server scripts/pg_test.sh starts and names in TEST_DATABASE_URL.
PG_URL = os.environ.get("TEST_DATABASE_URL")

# The example the layer is proven on — the template's `items` (a data table pushed to
# production) and `responses` (a cache), with a `<tool>_v1_*` view over each. A package
# declares its own in core/tables.py and creates them in a migration; the tests build this
# one on the engine (`example_schema`), so the package ships no example table.
EXAMPLE = sa.MetaData(naming_convention=tables.metadata.naming_convention)

items = sa.Table(
    f"{tables.PREFIX}items",
    EXAMPLE,
    sa.Column("id", sa.Integer, primary_key=True),
    sa.Column("phrase", sa.Text, nullable=False),  # as the user typed it
    sa.Column("phrase_key", sa.Text, nullable=False),  # core.normalize.norm_phrase(phrase)
    sa.Column("region", sa.Integer, nullable=False),
    sa.Column("created_at", sa.DateTime(timezone=True), nullable=False, server_default=sa.func.now()),
    sa.UniqueConstraint("phrase_key", "region"),  # the natural key
    info={"kind": "data", "push": {"since": "created_at"}},
)

responses = sa.Table(
    f"{tables.PREFIX}responses",
    EXAMPLE,
    sa.Column("id", sa.Integer, primary_key=True),
    sa.Column("phrase_key", sa.Text, nullable=False),
    sa.Column("region", sa.Integer, nullable=False),
    sa.Column("body", sa.Text, nullable=False),
    sa.Column("fetched_at", sa.DateTime(timezone=True), nullable=False, server_default=sa.func.now()),
    sa.UniqueConstraint("phrase_key", "region"),
    schema=tables.CACHE_SCHEMA,  # kind="cache" lives in its own schema (the Standard, Database)
    info={"kind": "cache"},
)

VIEWS = sa.MetaData()

v1_items = sa.Table(
    f"{tables.PREFIX}v1_items",
    VIEWS,
    sa.Column("phrase", sa.Text),
    sa.Column("phrase_key", sa.Text),
    sa.Column("region", sa.Integer),
    sa.Column("created_at", sa.DateTime(timezone=True)),
)

v1_responses = sa.Table(
    f"{tables.PREFIX}v1_responses",
    VIEWS,
    sa.Column("phrase_key", sa.Text),
    sa.Column("region", sa.Integer),
    sa.Column("body", sa.Text),
    sa.Column("fetched_at", sa.DateTime(timezone=True)),
)


def example_schema(engine: sa.Engine) -> None:
    """The example tables and their views, as a package's migration creates them."""
    EXAMPLE.create_all(engine)
    sources = {v1_items.name: items, v1_responses.name: responses}
    with engine.begin() as conn:
        for view in VIEWS.sorted_tables:
            table = sources[view.name]
            # A raw statement ignores SQLite's schema_translate_map: name the table as this engine has it.
            relation = table.fullname if db.is_postgres(conn) else table.name
            listed = ", ".join(column.name for column in view.columns)
            conn.execute(sa.text(f"DROP VIEW IF EXISTS {view.name}"))  # an older migration may have made it
            conn.execute(sa.text(f"CREATE VIEW {view.name} AS SELECT {listed} FROM {relation}"))  # noqa: S608


@pytest.fixture
def example(monkeypatch: pytest.MonkeyPatch) -> sa.Engine:
    """The layer over the example schema, in this test's own SQLite file."""
    engine = db.open_db()
    example_schema(engine)
    monkeypatch.setattr(db, "metadata", EXAMPLE)  # the layer works on the package's tables, here the example
    return engine


def invoke_json(*args: str) -> tuple[int, dict]:
    result = runner.invoke(app, [*args, "--json"])
    return result.exit_code, json.loads(result.stdout)


def _add_item(engine: sa.Engine, phrase: str = "Купить ёлку") -> None:
    with engine.begin() as conn:
        conn.execute(sa.insert(items).values(phrase=phrase, phrase_key=phrase.lower(), region=213))


def test_names_are_namespaced() -> None:
    assert all(table.name.startswith(db.PREFIX) for table in EXAMPLE.sorted_tables)
    tool = db.PREFIX.removesuffix("_")
    assert db.VERSION_TABLE.endswith(f"_{tool}")
    assert db.ENV_VAR.startswith(f"{tool.upper()}_")


