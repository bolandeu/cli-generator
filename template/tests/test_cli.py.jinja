@pytest.fixture
def fake_keyring(monkeypatch: pytest.MonkeyPatch):
    """In-memory stand-in for the OS keychain so auth tests don't touch it."""
    store: dict[tuple[str, str], str] = {}

    def fake_set_password(service: str, username: str, password: str) -> None:
        store[(service, username)] = password

    def fake_get_password(service: str, username: str) -> str | None:
        return store.get((service, username))

    def fake_delete_password(service: str, username: str) -> None:
        store.pop((service, username), None)

    monkeypatch.setattr("{{ package_name }}.credentials.manager.keyring.set_password", fake_set_password)
    monkeypatch.setattr("{{ package_name }}.credentials.manager.keyring.get_password", fake_get_password)
    monkeypatch.setattr("{{ package_name }}.credentials.manager.keyring.delete_password", fake_delete_password)
    return store


def test_auth_login_logout_status_round_trip(fake_keyring) -> None:
    result = runner.invoke(app, ["auth", "status", "--provider", "demo", "--json"])
    assert '"authenticated": false' in result.stdout

    result = runner.invoke(app, ["auth", "login", "--provider", "demo", "--non-interactive"])
    assert result.exit_code == 2  # no env var set, non-interactive can't prompt

    result = runner.invoke(
        app,
        ["auth", "login", "--provider", "demo", "--non-interactive"],
        env={"{{ package_name.upper() }}_DEMO_API_KEY": "secret"},
    )
    assert result.exit_code == 0

    result = runner.invoke(app, ["auth", "status", "--provider", "demo", "--json"])
    assert '"authenticated": true' in result.stdout

    result = runner.invoke(app, ["auth", "logout", "--provider", "demo", "--json"])
    assert result.exit_code == 0

    result = runner.invoke(app, ["auth", "status", "--provider", "demo", "--json"])
    assert '"authenticated": false' in result.stdout


