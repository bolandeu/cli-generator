def test_skill_install_writes_to_project_dir(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.chdir(tmp_path)
    result = runner.invoke(app, ["skill", "install", "--tool", "claude-code", "--project", "--json"])
    assert result.exit_code == 0
    installed = tmp_path / ".claude" / "skills" / "{{ package_name }}" / "SKILL.md"
    assert installed.is_file()
    assert "{{ package_name }}" in installed.read_text()


