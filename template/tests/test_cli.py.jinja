from __future__ import annotations

from pathlib import Path

import pytest
from typer.testing import CliRunner

from {{ package_name }}.cli import app

runner = CliRunner()


def test_init_and_status(tmp_path: Path) -> None:
    result = runner.invoke(app, ["--project", str(tmp_path), "init", "--name", "demo"])
    assert result.exit_code == 0

    result = runner.invoke(app, ["--project", str(tmp_path), "status", "--json"])
    assert result.exit_code == 0
    assert '"project": "demo"' in result.stdout


def test_init_is_idempotent_without_force(tmp_path: Path) -> None:
    runner.invoke(app, ["--project", str(tmp_path), "init", "--name", "demo"])
    runner.invoke(app, ["--project", str(tmp_path), "config", "set", "provider.name", "custom"])

    result = runner.invoke(app, ["--project", str(tmp_path), "init", "--name", "ignored", "--json"])
    assert result.exit_code == 0
    assert '"already_initialized": true' in result.stdout

    result = runner.invoke(app, ["--project", str(tmp_path), "config", "get", "provider.name", "--json"])
    assert '"value": "custom"' in result.stdout


def test_init_force_resets_config(tmp_path: Path) -> None:
    runner.invoke(app, ["--project", str(tmp_path), "init", "--name", "demo"])
    runner.invoke(app, ["--project", str(tmp_path), "config", "set", "provider.name", "custom"])

    result = runner.invoke(app, ["--project", str(tmp_path), "init", "--name", "demo", "--force", "--json"])
    assert result.exit_code == 0
    assert '"already_initialized": false' in result.stdout

    result = runner.invoke(app, ["--project", str(tmp_path), "config", "get", "provider.name", "--json"])
    assert '"value": "default"' in result.stdout


def test_status_without_init_fails(tmp_path: Path) -> None:
    result = runner.invoke(app, ["--project", str(tmp_path), "status", "--json"])
    assert result.exit_code == 4
    assert '"code": "PROJECT_NOT_INITIALIZED"' in result.stdout


def test_doctor_json(tmp_path: Path) -> None:
    result = runner.invoke(app, ["--project", str(tmp_path), "doctor", "--json"])
    assert result.exit_code == 0
    assert '"healthy"' in result.stdout


def test_doctor_reports_config_parse_error(tmp_path: Path) -> None:
    runner.invoke(app, ["--project", str(tmp_path), "init", "--name", "demo"])
    (tmp_path / ".{{ package_name }}" / "config.toml").write_text("this is not valid toml [[[")

    result = runner.invoke(app, ["--project", str(tmp_path), "doctor", "--json"])
    assert result.exit_code == 0
    assert '"name": "config", "ok": false' in result.stdout
    assert '"detail"' in result.stdout


def test_config_get_set_round_trip(tmp_path: Path) -> None:
    runner.invoke(app, ["--project", str(tmp_path), "init", "--name", "demo"])

    result = runner.invoke(app, ["--project", str(tmp_path), "config", "set", "provider.name", "custom"])
    assert result.exit_code == 0

    result = runner.invoke(app, ["--project", str(tmp_path), "config", "get", "provider.name", "--json"])
    assert result.exit_code == 0
    assert '"value": "custom"' in result.stdout


def test_config_get_unknown_key_fails(tmp_path: Path) -> None:
    runner.invoke(app, ["--project", str(tmp_path), "init", "--name", "demo"])
    result = runner.invoke(app, ["--project", str(tmp_path), "config", "get", "does.not.exist", "--json"])
    assert result.exit_code == 2
    assert '"code": "INVALID_ARGUMENTS"' in result.stdout


def test_config_set_unknown_key_fails_without_persisting(tmp_path: Path) -> None:
    runner.invoke(app, ["--project", str(tmp_path), "init", "--name", "demo"])

    result = runner.invoke(app, ["--project", str(tmp_path), "config", "set", "does.not.exist", "x", "--json"])
    assert result.exit_code == 2
    assert '"code": "INVALID_ARGUMENTS"' in result.stdout

    result = runner.invoke(app, ["--project", str(tmp_path), "config", "list", "--json"])
    assert "does" not in result.stdout


