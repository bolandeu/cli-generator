"""The tool's first migration: an empty revision, so the chain and `alembic_version_<tool>` exist.

Replace the body of `upgrade` with the tool's first schema change — literal `op.create_table`
and `op.execute("CREATE VIEW ...")` calls, names written out: a migration is history and must
not change when the code it would import does. `core/tables.py` declares the same objects;
`tests/test_db.py` fails when the two disagree.

A table of kind "cache" goes into the PostgreSQL schema `cache` from the start
(`schema="cache"` in `op.create_table`). Moving an existing table there is PostgreSQL-only
and takes its rows as they are, so guard it (SQLite has no schemas):

    if op.get_bind().dialect.name == "postgresql":
        op.execute("ALTER TABLE public.<tool>_<name> SET SCHEMA cache")
"""

revision = "0001"
down_revision = None
branch_labels = None
depends_on = None


def upgrade() -> None:
    """The tool's first schema change goes here."""


def downgrade() -> None:
    """Undo `upgrade`, in the reverse order."""
