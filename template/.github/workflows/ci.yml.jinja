name: CI

# One Linux job on the lowest supported Python keeps private repos inside the
# free Actions minutes; the full gate also runs locally on the Mac before a
# release (scripts/release.py). See tools/docs/standard-release.md §6.
on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0 # tags for the version (uv-dynamic-versioning), base branch for towncrier check
      - uses: astral-sh/setup-uv@v10
        with:
          enable-cache: true
          python-version: "3.11" # lowest from requires-python
      - run: uv lock --check
      - run: uv sync
      - run: uv run ruff check .
      - run: uv run ruff format --check .
      - run: uv run ty check
      - run: uv run pytest
      - name: Changelog fragment present
        # Dependabot's grouped bumps aren't user-visible changes and can't add a fragment.
        if: github.event_name == 'pull_request' && github.actor != 'dependabot[bot]'
        run: uv run towncrier check --compare-with origin/${{ '{{' }} github.base_ref {{ '}}' }}

      # The distribution path — the same build+install `uv tool install "git+..."`
      # performs on a user's machine. Catches packaging mistakes (missing
      # package data, broken entry point) that `uv run` never notices.
      - name: Install as a tool
        run: |
          uv tool install .
          echo "$(uv tool dir --bin)" >> "$GITHUB_PATH"
      - run: {{ package_name }} --version
      - run: {{ package_name }} --ai
      - run: {{ package_name }} doctor

      # Known vulnerabilities in the locked dependency set (OSV-Scanner reads
      # uv.lock natively). Dependabot opens the upgrade PRs; this is what
      # fails the build until they're merged. Locally: `osv-scanner --lockfile=uv.lock`.
      - uses: google/osv-scanner-action/osv-scanner-action@v2.6.0
        with:
          scan-args: |-
            --lockfile=uv.lock
