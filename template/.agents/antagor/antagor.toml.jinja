schema = 1
prefix = "{{ antagor_prefix }}"
name = "{{ cli_name }}"
worker = "claude-code"
checks = ["python3 scripts/check_command_docstrings.py", '{{ gate_command }}']

[review]
required_types = ["feature", "bugfix"]  # chore and docs: the short path without review

[publish]
versioning = "semver"
changelog = "CHANGELOG.md"
deploy_command = "sh scripts/deploy.sh"
