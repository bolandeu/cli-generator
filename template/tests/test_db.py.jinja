@pytest.mark.skipif(not PG_URL, reason="TEST_DATABASE_URL not set")
def test_pg_no_cache_schema_is_a_clear_error(monkeypatch: pytest.MonkeyPatch) -> None:
    """Case 7a: schema `cache` missing → a clear error, nothing migrated at all."""
    engine = _pg_engine(monkeypatch)
    with engine.begin() as conn:
        command.upgrade(db.alembic_config(conn), "0001")
        conn.execute(sa.text(f"DROP SCHEMA {tables.CACHE_SCHEMA}"))
    code, payload = invoke_json("db", "upgrade")
    assert code == 5 and payload["error"]["code"] == "DATABASE_UNAVAILABLE"
    assert f"schema '{tables.CACHE_SCHEMA}'" in payload["error"]["message"]
    with engine.connect() as conn:
        assert db.current_revision(conn) == "0001"
        assert _where(conn, tables.responses.name) == "public"
    engine.dispose()


@pytest.mark.skipif(not PG_URL, reason="TEST_DATABASE_URL not set")
def test_pg_no_rights_on_cache_schema_is_a_clear_error(monkeypatch: pytest.MonkeyPatch) -> None:
    """Case 7b: a role without CREATE on `cache` → a clear error, no partial move."""
    engine = _pg_engine(monkeypatch)
    role = f"{db.PREFIX}limited"
    with engine.begin() as conn:
        conn.execute(sa.text(f"DROP OWNED BY {role}") if _role_exists(conn, role) else sa.text("SELECT 1"))
        conn.execute(sa.text(f"DROP ROLE IF EXISTS {role}"))
        conn.execute(sa.text(f"CREATE ROLE {role} LOGIN PASSWORD 'limited'"))
        conn.execute(sa.text(f"GRANT CREATE, USAGE ON SCHEMA public TO {role}"))
        conn.execute(sa.text(f"GRANT USAGE ON SCHEMA {tables.CACHE_SCHEMA} TO {role}"))  # but not CREATE
    limited_url = sa.make_url(PG_URL or "").set(username=role, password="limited")  # noqa: S106
    monkeypatch.setenv(db.ENV_VAR, limited_url.render_as_string(hide_password=False))
    limited = db.open_db(check=False)
    with limited.begin() as conn:
        command.upgrade(db.alembic_config(conn), "0001")  # its own tables, in public
    code, payload = invoke_json("db", "upgrade")
    assert code == 5 and payload["error"]["code"] == "DATABASE_UNAVAILABLE"
    assert "CREATE" in payload["error"]["message"]
    with limited.connect() as conn:
        assert db.current_revision(conn) == "0001"
        assert _where(conn, tables.responses.name) == "public"
    limited.dispose()
    with engine.begin() as conn:
        _pg_clean_slate(conn)
        conn.execute(sa.text(f"DROP OWNED BY {role}"))
        conn.execute(sa.text(f"DROP ROLE {role}"))
    engine.dispose()


def _role_exists(conn: sa.Connection, role: str) -> bool:
    return bool(conn.execute(sa.text("SELECT 1 FROM pg_roles WHERE rolname = :role"), {"role": role}).scalar())
