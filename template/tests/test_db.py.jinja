def test_push_table_rules(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(db, "push_tables", lambda: [])
    with pytest.raises(InvalidArguments, match="No table"):
        db.push(db.open_db(), db.open_db())
    keyless = sa.Table(
        f"{db.PREFIX}keyless", sa.MetaData(), sa.Column("id", sa.Integer, primary_key=True), info={"push": {}}
    )
    monkeypatch.setattr(db, "push_tables", lambda: [keyless])
    with pytest.raises(InvalidArguments, match="natural key"):
        db.push(db.open_db(), db.open_db())
    no_since = items.to_metadata(sa.MetaData())
    no_since.info["push"] = {}
    monkeypatch.setattr(db, "push_tables", lambda: [no_since])
    with pytest.raises(InvalidArguments, match="since"):
        db.push(db.open_db(), db.open_db(), since=datetime(2026, 1, 1))


def _pg_engine(monkeypatch: pytest.MonkeyPatch) -> sa.Engine:
    """The throwaway server, wiped of this tool's objects: schema `cache` empty, nothing migrated."""
    assert PG_URL
    assert sa.make_url(PG_URL).host in ("127.0.0.1", "localhost"), "TEST_DATABASE_URL must be scripts/pg_test.sh's"
    monkeypatch.setenv(db.ENV_VAR, PG_URL)
    engine = db.open_db(check=False)
    with engine.begin() as conn:
        _pg_clean_slate(conn)
    monkeypatch.setattr(db, "metadata", EXAMPLE)
    return engine


def _pg_clean_slate(conn: sa.Connection) -> None:
    for view in VIEWS.sorted_tables:
        conn.execute(sa.text(f"DROP VIEW IF EXISTS {view.name}"))
    for table in EXAMPLE.sorted_tables:
        conn.execute(sa.text(f"DROP TABLE IF EXISTS {table.name}, {tables.CACHE_SCHEMA}.{table.name} CASCADE"))
    conn.execute(sa.text(f"DROP TABLE IF EXISTS {db.VERSION_TABLE}"))
    conn.execute(sa.text(f"CREATE SCHEMA IF NOT EXISTS {tables.CACHE_SCHEMA}"))


def _where(conn: sa.Connection, name: str) -> str | None:
    """The schema table `name` is in, None when there is none."""
    return conn.execute(
        sa.text("SELECT table_schema FROM information_schema.tables WHERE table_name = :name"), {"name": name}
    ).scalar()


@pytest.mark.skipif(not PG_URL, reason="TEST_DATABASE_URL not set")
def test_postgres_round_trip(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    assert PG_URL
    # It drops this tool's tables: never anything but a throwaway local server.
    engine = _pg_engine(monkeypatch)
    with engine.begin() as conn:  # a clean slate: only this tool's objects
        conn.execute(sa.text("CREATE TABLE IF NOT EXISTS directus_users (id int)"))  # someone else's table
    with pytest.raises(DatabaseNotMigrated):
        db.open_db()
    assert db.upgrade(engine).up_to_date
    db.check_schema(engine)
    example_schema(engine)
    _assert_views_match(engine)

    source = db.sqlite_engine(tmp_path / "old.db")
    db.upgrade(source)
    example_schema(source)
    _add_item(source)
    assert db.import_sqlite(tmp_path / "old.db", engine) == {items.name: 1, responses.name: 0}
    _add_item(engine, "вторая")  # the sequence moved past the imported ids
    with engine.connect() as conn:
        assert conn.execute(sa.text(f"SELECT count(*) FROM {v1_items.name}")).scalar_one() == 2  # noqa: S608
        assert sa.inspect(conn).has_table("directus_users")

    monkeypatch.setenv(db.PROD_ENV_VAR, PG_URL)  # db push into real PostgreSQL: ON CONFLICT, RETURNING
    local = db.sqlite_engine(tmp_path / "local.db")
    db.upgrade(local)
    example_schema(local)
    _add_item(local)  # "Купить ёлку" is already there
    _add_item(local, "третья")
    prod = db.prod_engine()
    assert db.push(local, prod, dry_run=True) == {items.name: {"selected": 2, "sent": 1, "skipped": 1}}
    assert db.push(local, prod)[items.name]["sent"] == 1
    assert db.push(local, prod)[items.name]["sent"] == 0
    prod.dispose()
    engine.dispose()


def _assert_views_match(engine: sa.Engine) -> None:
    inspector = sa.inspect(engine)
    existing = set(inspector.get_view_names())
    for view in VIEWS.sorted_tables:
        assert view.name.startswith(f"{db.PREFIX}v"), f"{view.name}: a view's name is <tool>_v<N>_<name>"
        assert view.name in existing, f"{view.name} is declared in tables.views but no migration creates it"
        columns = [column["name"] for column in inspector.get_columns(view.name)]
        assert columns == [column.name for column in view.columns], f"{view.name}: columns differ from tables.views"


# --- The cache schema: kind="cache" tables live in PostgreSQL schema `cache` ------------
# (public holds the data).

RESPONSE = {"phrase_key": "купить елку", "region": 213, "body": '{"top": []}'}


def test_cache_tables_and_only_they_are_in_the_cache_schema() -> None:
    for table in EXAMPLE.sorted_tables:
        expected = tables.CACHE_SCHEMA if table.info.get("kind") == "cache" else None
        assert table.schema == expected, f"{table.name}: kind={table.info.get('kind')} needs schema={expected!r}"
    assert any(table.schema == tables.CACHE_SCHEMA for table in EXAMPLE.sorted_tables)  # the example


def test_sqlite_ignores_the_cache_schema(example: sa.Engine) -> None:
    """Case 5: on SQLite the cache table is in the same file, read and written as before."""
    with example.begin() as conn:
        conn.execute(sa.insert(responses).values(**RESPONSE))
    with example.connect() as conn:
        assert conn.execute(sa.select(responses.c.body)).scalar_one() == RESPONSE["body"]
        assert conn.execute(sa.text(f"SELECT count(*) FROM {v1_responses.name}")).scalar_one() == 1  # noqa: S608
    assert responses.name in sa.inspect(example).get_table_names()


@pytest.mark.skipif(not PG_URL, reason="TEST_DATABASE_URL not set")
def test_pg_push_writes_into_the_cache_schema(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    """Case 6: db push sends local cache rows into cache.<table> in production."""
    engine = _pg_engine(monkeypatch)
    db.upgrade(engine)
    example_schema(engine)
    monkeypatch.setenv(db.PROD_ENV_VAR, PG_URL or "")
    local = db.sqlite_engine(tmp_path / "local.db")
    db.upgrade(local)
    example_schema(local)
    with local.begin() as conn:
        conn.execute(sa.insert(responses).values(**RESPONSE))
    monkeypatch.setattr(db, "push_tables", lambda: [responses])  # a cache the tool chose to push
    prod = db.prod_engine()
    assert db.push(local, prod)[responses.name]["sent"] == 1
    with engine.connect() as conn:
        count = sa.text(f"SELECT count(*) FROM {tables.CACHE_SCHEMA}.{responses.name}")  # noqa: S608
        assert conn.execute(count).scalar_one() == 1
    prod.dispose()
    engine.dispose()


@pytest.mark.skipif(not PG_URL, reason="TEST_DATABASE_URL not set")
def test_pg_no_cache_schema_is_a_clear_error(monkeypatch: pytest.MonkeyPatch) -> None:
    """Case 7a: schema `cache` missing → a clear error, nothing migrated at all."""
    engine = _pg_engine(monkeypatch)
    with engine.begin() as conn:
        conn.execute(sa.text(f"DROP SCHEMA {tables.CACHE_SCHEMA} CASCADE"))
    code, payload = invoke_json("db", "upgrade")
    assert code == 5 and payload["error"]["code"] == "DATABASE_UNAVAILABLE"
    assert f"schema '{tables.CACHE_SCHEMA}'" in payload["error"]["message"]
    with engine.connect() as conn:
        assert db.current_revision(conn) is None
        assert _where(conn, db.VERSION_TABLE) is None
    engine.dispose()


@pytest.mark.skipif(not PG_URL, reason="TEST_DATABASE_URL not set")
def test_pg_no_rights_on_cache_schema_is_a_clear_error(monkeypatch: pytest.MonkeyPatch) -> None:
    """Case 7b: a role without CREATE on `cache` → a clear error, no partial move."""
    engine = _pg_engine(monkeypatch)
    role = f"{db.PREFIX}limited"
    with engine.begin() as conn:
        conn.execute(sa.text(f"DROP OWNED BY {role}") if _role_exists(conn, role) else sa.text("SELECT 1"))
        conn.execute(sa.text(f"DROP ROLE IF EXISTS {role}"))
        conn.execute(sa.text(f"CREATE ROLE {role} LOGIN PASSWORD 'limited'"))
        conn.execute(sa.text(f"GRANT CREATE, USAGE ON SCHEMA public TO {role}"))
        conn.execute(sa.text(f"GRANT USAGE ON SCHEMA {tables.CACHE_SCHEMA} TO {role}"))  # but not CREATE
    limited_url = sa.make_url(PG_URL or "").set(username=role, password="limited")  # noqa: S106
    monkeypatch.setenv(db.ENV_VAR, limited_url.render_as_string(hide_password=False))
    limited = db.open_db(check=False)
    code, payload = invoke_json("db", "upgrade")
    assert code == 5 and payload["error"]["code"] == "DATABASE_UNAVAILABLE"
    assert "CREATE" in payload["error"]["message"]
    with limited.connect() as conn:
        assert db.current_revision(conn) is None
    limited.dispose()
    with engine.begin() as conn:
        conn.execute(sa.text(f"DROP OWNED BY {role}"))
        conn.execute(sa.text(f"DROP ROLE {role}"))
    engine.dispose()


def _role_exists(conn: sa.Connection, role: str) -> bool:
    return bool(conn.execute(sa.text("SELECT 1 FROM pg_roles WHERE rolname = :role"), {"role": role}).scalar())
