    engine.dispose()


@pytest.mark.skipif(not PG_URL, reason="TEST_DATABASE_URL not set")
def test_pg_push_writes_into_the_cache_schema(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    """Case 6: db push sends local cache rows into cache.<table> in production."""
    engine = _pg_engine(monkeypatch)
