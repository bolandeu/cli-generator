def test_require_confirmation_blocks_non_interactive_without_confirm() -> None:
    from {{ package_name }} import output
    from {{ package_name }}.core.errors import InvalidArguments

    class _Ctx:
        obj = {"non_interactive": True}

    try:
        output.require_confirmation(_Ctx(), "Delete everything", confirm=False)
        assert False, "expected InvalidArguments"
    except InvalidArguments:
        pass

    # --confirm bypasses the prompt/non-interactive check entirely.
    output.require_confirmation(_Ctx(), "Delete everything", confirm=True)
