schema = 1
prefix = "{{ antagor_prefix }}"
name = "{{ cli_name }}"
checks = ["python3 scripts/check_command_docstrings.py"]
heavy = ["rb-release check"]

[review]
required_types = ["feature", "bugfix"]  # chore and docs: the short path without review

[publish]
versioning = "semver"
changelog = "CHANGELOG.md"
deploy_command = "sh scripts/deploy.sh"
gate = "remote"
gate_status_url = "https://homeserver.tailee01ab.ts.net:3000/api/v1/repos/bolandeu/{{ (repository_url.rstrip('/').split('/')[-1] if repository_url else cli_name) }}/commits/{commit}/status"
