name: CI

# Optional (tools/docs/standard-release.md §6): the authoritative gate is the
# local `uv run scripts/release.py --check`, which every release runs anyway.
# If kept, CI is one Linux job on the lowest supported Python repeating it on
# a clean machine — delete this file to save Actions minutes on a private repo.
on:
  push:
    branches: [main]
    tags: ["v*"]
  pull_request:

jobs:
  test:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0 # tags: the build's version comes from them
      - uses: astral-sh/setup-uv@v10
        with:
          enable-cache: true
          python-version: "3.11" # lowest from requires-python

      # Everything: lock, lint, format, types, tests (incl. help snapshots and
      # the auth status shape), changelog fragment, wheel build + install +
      # `{{ package_name }} --version` / `--help`.
      - run: uv run scripts/release.py --check

      # Known vulnerabilities in the locked dependency set (OSV-Scanner reads
      # uv.lock natively). Dependabot opens the upgrade PRs; this is what
      # fails the build until they're merged. Locally: `osv-scanner --lockfile=uv.lock`.
      - uses: google/osv-scanner-action/osv-scanner-action@v2.6.0
        with:
          scan-args: |-
            --lockfile=uv.lock
