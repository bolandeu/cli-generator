def test_import_sqlite(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    source = db.sqlite_engine(tmp_path / "old.db")
    db.upgrade(source)
    _add_item(source)
    _add_item(source, "вторая")
    target = db.sqlite_engine(tmp_path / "shared.db")
    db.upgrade(target)
    _as_postgres(monkeypatch, target)

    code, payload = invoke_json("db", "import-sqlite", str(tmp_path / "old.db"), "--dry-run")
    assert code == 0 and payload["rows"] == {tables.items.name: 2, tables.responses.name: 0}
    with target.connect() as conn:
        assert conn.execute(sa.select(sa.func.count()).select_from(tables.items)).scalar_one() == 0

    code, payload = invoke_json("db", "import-sqlite", str(tmp_path / "old.db"))
    assert code == 0 and payload["rows"] == {tables.items.name: 2, tables.responses.name: 0}
    with target.connect() as conn:
        assert {row.phrase for row in conn.execute(sa.select(tables.items))} == {"Купить ёлку", "вторая"}

    code, payload = invoke_json("db", "import-sqlite", str(tmp_path / "old.db"))
    assert code == 2 and "not empty" in payload["error"]["message"]


def test_import_sqlite_rejects_bad_sources(tmp_path: Path) -> None:
    target = db.sqlite_engine(tmp_path / "shared.db")
    with pytest.raises(InvalidArguments, match="No SQLite"):
        db.import_sqlite(tmp_path / "missing.db", target)
    db.upgrade(target)
    with pytest.raises(InvalidArguments, match="same database"):
        db.import_sqlite(tmp_path / "shared.db", target)


def _prod(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> sa.Engine:
    """A migrated stand-in for production, behind <TOOL>_PROD_DATABASE_URL."""
    prod = db.sqlite_engine(tmp_path / "prod.db")
    db.upgrade(prod)
    monkeypatch.setenv(db.PROD_ENV_VAR, "postgresql://prod")
    monkeypatch.setattr(db, "postgres_engine", lambda *_args, **_kwargs: prod)
    return prod


def _phrases(engine: sa.Engine) -> list[tuple[int, str]]:
    with engine.connect() as conn:
        return [tuple(row) for row in conn.execute(sa.select(tables.items.c.id, tables.items.c.phrase).order_by("id"))]


def test_push(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    local = db.open_db()
    for phrase in ("один", "два", "три"):
        _add_item(local, phrase)
    prod = _prod(monkeypatch, tmp_path)
    _add_item(prod, "два")  # already there: skipped, not duplicated
    _add_item(prod, "четыре")

    code, payload = invoke_json("db", "push", "--dry-run")
    assert code == 0, payload
    assert payload["tables"] == {tables.items.name: {"selected": 3, "sent": 2, "skipped": 1}}
    assert len(_phrases(prod)) == 2

    code, payload = invoke_json("db", "push")
    assert payload["tables"][tables.items.name]["sent"] == 2
    assert [phrase for _id, phrase in _phrases(prod)] == ["два", "четыре", "один", "три"]  # prod's own ids

    code, payload = invoke_json("db", "push")
    assert payload["tables"][tables.items.name] == {"selected": 3, "sent": 0, "skipped": 3}


def test_push_filters(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    local = db.open_db()
    _add_item(local, "старая")
    with local.begin() as conn:
        conn.execute(sa.update(tables.items).values(created_at=datetime(2020, 1, 1)))
    _add_item(local, "новая")
    _prod(monkeypatch, tmp_path)
    _code, payload = invoke_json("db", "push", "--since", "2026-01-01", "--dry-run")
    assert payload["tables"][tables.items.name]["selected"] == 1
    _code, payload = invoke_json("db", "push", "--where", "phrase = 'старая'", "--dry-run")
    assert payload["tables"][tables.items.name]["selected"] == 1
    code, payload = invoke_json("db", "push", "--table", "nope")
    assert code == 2 and "Not a push table" in payload["error"]["message"]


def test_push_needs_a_migrated_prod(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    code, payload = invoke_json("db", "push")
    assert code == 2 and db.PROD_ENV_VAR in payload["error"]["message"]
    prod = db.sqlite_engine(tmp_path / "prod.db")  # never migrated
    monkeypatch.setenv(db.PROD_ENV_VAR, "postgresql://prod")
    monkeypatch.setattr(db, "postgres_engine", lambda *_args, **_kwargs: prod)
    code, payload = invoke_json("db", "push")
    assert code == 1 and payload["error"]["code"] == "DATABASE_NOT_MIGRATED"


def test_push_table_rules(monkeypatch: pytest.MonkeyPatch) -> None:
    monkeypatch.setattr(db, "push_tables", lambda: [])
    with pytest.raises(InvalidArguments, match="No table"):
        db.push(db.open_db(), db.open_db())
    keyless = sa.Table(
        f"{db.PREFIX}keyless", sa.MetaData(), sa.Column("id", sa.Integer, primary_key=True), info={"push": {}}
    )
    monkeypatch.setattr(db, "push_tables", lambda: [keyless])
    with pytest.raises(InvalidArguments, match="natural key"):
        db.push(db.open_db(), db.open_db())
    no_since = tables.items.to_metadata(sa.MetaData())
    no_since.info["push"] = {}
    monkeypatch.setattr(db, "push_tables", lambda: [no_since])
    with pytest.raises(InvalidArguments, match="since"):
        db.push(db.open_db(), db.open_db(), since=datetime(2026, 1, 1))


@pytest.mark.skipif(not PG_URL, reason="TEST_DATABASE_URL not set")
def test_postgres_round_trip(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    assert PG_URL
    # It drops this tool's tables: never anything but a throwaway local server.
    assert sa.make_url(PG_URL).host in ("127.0.0.1", "localhost"), "TEST_DATABASE_URL must be scripts/pg_test.sh's"
    monkeypatch.setenv(db.ENV_VAR, PG_URL)
    engine = db.open_db(check=False)
    with engine.begin() as conn:  # a clean slate: only this tool's objects
        _pg_clean_slate(conn)
        conn.execute(sa.text("CREATE TABLE IF NOT EXISTS directus_users (id int)"))  # someone else's table
    with pytest.raises(DatabaseNotMigrated):
        db.open_db()
    assert db.upgrade(engine).up_to_date
    db.check_schema(engine)
    _assert_views_match(engine)

    source = db.sqlite_engine(tmp_path / "old.db")
    db.upgrade(source)
    _add_item(source)
    assert db.import_sqlite(tmp_path / "old.db", engine) == {tables.items.name: 1, tables.responses.name: 0}
    _add_item(engine, "вторая")  # the sequence moved past the imported ids
    with engine.connect() as conn:
        assert conn.execute(sa.text(f"SELECT count(*) FROM {db.PREFIX}v1_items")).scalar_one() == 2  # noqa: S608
        assert sa.inspect(conn).has_table("directus_users")

    monkeypatch.setenv(db.PROD_ENV_VAR, PG_URL)  # db push into real PostgreSQL: ON CONFLICT, RETURNING
    local = db.sqlite_engine(tmp_path / "local.db")
    db.upgrade(local)
    _add_item(local)  # "Купить ёлку" is already there
    _add_item(local, "третья")
    prod = db.prod_engine()
    assert db.push(local, prod, dry_run=True) == {tables.items.name: {"selected": 2, "sent": 1, "skipped": 1}}
    assert db.push(local, prod)[tables.items.name]["sent"] == 1
    assert db.push(local, prod)[tables.items.name]["sent"] == 0
    prod.dispose()
    engine.dispose()


# --- The cache schema: kind="cache" tables live in PostgreSQL schema `cache` ------------
# (public holds the data).

RESPONSE = {"phrase_key": "купить елку", "region": 213, "body": '{"top": []}'}


def _old_cli(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    """Make this CLI the previous release: its migrations stop at 0001 (before the move to `cache`)."""
    source = Path(db.__file__).parent.parent / "migrations"
    (tmp_path / "old" / "versions").mkdir(parents=True)
    for name in ("env.py", "script.py.mako"):
        (tmp_path / "old" / name).write_text((source / name).read_text())
    for path in (source / "versions").glob("0001_*.py"):
        (tmp_path / "old" / "versions" / path.name).write_text(path.read_text())
    new_config = db.alembic_config

    def old_config(connection=None):
        config = new_config(connection)
        config.set_main_option("script_location", str(tmp_path / "old"))
        return config

    monkeypatch.setattr(db, "alembic_config", old_config)


def test_cache_tables_and_only_they_are_in_the_cache_schema() -> None:
    for table in tables.metadata.sorted_tables:
        expected = tables.CACHE_SCHEMA if table.info.get("kind") == "cache" else None
        assert table.schema == expected, f"{table.name}: kind={table.info.get('kind')} needs schema={expected!r}"
    assert any(table.schema == tables.CACHE_SCHEMA for table in tables.metadata.sorted_tables)  # the example


def test_sqlite_ignores_the_cache_schema() -> None:
    """Case 5: on SQLite the cache table is in the same file, read and written as before."""
    engine = db.open_db()
    with engine.begin() as conn:
        conn.execute(sa.insert(tables.responses).values(**RESPONSE))
    with engine.connect() as conn:
        assert conn.execute(sa.select(tables.responses.c.body)).scalar_one() == RESPONSE["body"]
        assert conn.execute(sa.text(f"SELECT count(*) FROM {db.PREFIX}v1_responses")).scalar_one() == 1  # noqa: S608
    assert tables.responses.name in sa.inspect(engine).get_table_names()


def test_old_cli_on_a_moved_sqlite_database(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    """Case 4 (SQLite): the previous release refuses a database migrated past it, touching nothing."""
    db.open_db()  # migrated to head by this release
    _old_cli(monkeypatch, tmp_path)
    code, payload = invoke_json("db", "upgrade")
    assert code == 6 and payload["error"]["code"] == "CLI_TOO_OLD"
    with pytest.raises(DatabaseTooNew):
        db.open_db()


def _pg_engine(monkeypatch: pytest.MonkeyPatch) -> sa.Engine:
    """The throwaway server, wiped of this tool's objects, with schema `cache` present."""
    assert PG_URL
    assert sa.make_url(PG_URL).host in ("127.0.0.1", "localhost"), "TEST_DATABASE_URL must be scripts/pg_test.sh's"
    monkeypatch.setenv(db.ENV_VAR, PG_URL)
    engine = db.open_db(check=False)
    with engine.begin() as conn:
        _pg_clean_slate(conn)
    return engine


def _pg_clean_slate(conn: sa.Connection) -> None:
    for view in tables.views.sorted_tables:
        conn.execute(sa.text(f"DROP VIEW IF EXISTS {view.name}"))
    for table in tables.metadata.sorted_tables:
        conn.execute(sa.text(f"DROP TABLE IF EXISTS {table.name}, {tables.CACHE_SCHEMA}.{table.name} CASCADE"))
    conn.execute(sa.text(f"DROP TABLE IF EXISTS {db.VERSION_TABLE}"))
    conn.execute(sa.text(f"CREATE SCHEMA IF NOT EXISTS {tables.CACHE_SCHEMA}"))


def _where(conn: sa.Connection, name: str) -> str | None:
    """The schema table `name` is in, None when there is none."""
    return conn.execute(
        sa.text("SELECT table_schema FROM information_schema.tables WHERE table_name = :name"), {"name": name}
    ).scalar()


@pytest.mark.skipif(not PG_URL, reason="TEST_DATABASE_URL not set")
def test_pg_upgrade_moves_cache_tables(monkeypatch: pytest.MonkeyPatch) -> None:
    """Cases 1-3: db upgrade moves the cache table, rows and dates intact; it works after; so does the view."""
    engine = _pg_engine(monkeypatch)
    with engine.begin() as conn:
        command.upgrade(db.alembic_config(conn), "0001")  # the layout before: everything in public
        fetched = datetime(2026, 9, 1, 12, 30, tzinfo=UTC)
        conn.execute(
            sa.text(
                f"INSERT INTO {tables.responses.name} (phrase_key, region, body, fetched_at)"  # noqa: S608
                " VALUES (:phrase_key, :region, :body, :fetched_at)"
            ),
            {**RESPONSE, "fetched_at": fetched},
        )
        assert _where(conn, tables.responses.name) == "public"
    view_columns = [c["name"] for c in sa.inspect(engine).get_columns(f"{db.PREFIX}v1_responses")]

    code, payload = invoke_json("db", "upgrade")
    assert code == 0 and payload["up_to_date"], payload
    with engine.connect() as conn:
        assert _where(conn, tables.responses.name) == tables.CACHE_SCHEMA  # and no longer in public
        row = conn.execute(sa.select(tables.responses.c.phrase_key, tables.responses.c.fetched_at)).one()
        assert row == (RESPONSE["phrase_key"], fetched)
    with db.connect() as conn:  # case 2: written and read through tables.py after the move
        conn.execute(sa.insert(tables.responses).values(**{**RESPONSE, "region": 2}))
    with engine.connect() as conn:
        assert conn.execute(sa.select(sa.func.count()).select_from(tables.responses)).scalar_one() == 2
        view = sa.text(f"SELECT region FROM {db.PREFIX}v1_responses ORDER BY region")  # noqa: S608
        assert conn.execute(view).scalars().all() == [2, 213]  # case 3
    assert [c["name"] for c in sa.inspect(engine).get_columns(f"{db.PREFIX}v1_responses")] == view_columns
    _assert_views_match(engine)
    engine.dispose()


@pytest.mark.skipif(not PG_URL, reason="TEST_DATABASE_URL not set")
def test_pg_old_cli_on_a_moved_database(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    """Case 4: the previous release on a moved base → CLI_TOO_OLD (exit 6), creates nothing."""
    engine = _pg_engine(monkeypatch)
    db.upgrade(engine)
    _old_cli(monkeypatch, tmp_path)
